      "html": "<header class=\"ds-nav\"><span class=\"ds-nav-logo\">MUNCH</span><nav class=\"ds-nav-links\"><a href=\"#\">life</a><a href=\"#\">feeding</a><a href=\"#\">meals</a><a href=\"#\">story</a></nav><button class=\"ds-nav-sound\" aria-label=\"Sound\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M11 5 6 9H2v6h4l5 4V5Z\"/><path d=\"M15.5 8.5a5 5 0 0 1 0 7\"/></svg></button></header>",
      "css": ".ds-nav{display:flex;align-items:center;justify-content:space-between;gap:1rem;height:72px;padding:0 40px;background:#2a1633;color:#fff3e2}.ds-nav-logo{font-family:'Bagel Fat One',sans-serif;font-size:1.55rem;line-height:1}.ds-nav-links{display:flex;gap:1.5rem;font-family:'Gabarito Variable','Gabarito',system-ui,sans-serif;font-weight:600;font-size:.95rem}.ds-nav-links a{color:#fff3e2;text-decoration:none}.ds-nav-links a:hover{color:#ffd166}.ds-nav-links a:focus-visible{outline:3px solid #2a1633;outline-offset:3px;box-shadow:0 0 0 6px #ffd166}.ds-nav-sound{display:flex;align-items:center;justify-content:center;width:40px;height:40px;border:0;border-radius:9999px;background:transparent;color:#fff3e2;box-shadow:inset 0 0 0 2px #5c3a63;cursor:pointer}.ds-nav-sound:hover{color:#ffd166;box-shadow:inset 0 0 0 2px #ffd166}"
