      "css": ".ds-lcdmenu{display:flex;gap:4px;list-style:none;margin:0;padding:6px 8px;background:#c4cfa1;border-bottom:4px solid #2f3a22}.ds-lcdmenu li{flex:1}.ds-lcdmenu a{display:flex;justify-content:center;padding:6px 8px;font-family:'DotGothic16',monospace;font-size:.9rem;text-transform:uppercase;text-decoration:none;color:#2f3a22;transition:background-color .1s steps(2)}.ds-lcdmenu a:hover{background:#b4c091}.ds-lcdmenu a.on{background:#2f3a22;color:#c4cfa1}.ds-lcdmenu a:focus-visible{outline:3px solid #2a1633;outline-offset:3px;box-shadow:0 0 0 6px #ffd166}"
