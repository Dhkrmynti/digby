  "components": [
    {
      "name": "Buy Key",
      "kind": "button",
      "refersTo": "button-buy",
      "description": "The one bubblegum key: buy $MUNCH. Lifts on hover, presses into the card.",
      "html": "<a class=\"ds-btn-buy\" href=\"#\">buy $MUNCH <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\"><path d=\"M7 17 17 7M8 7h9v9\"/></svg></a>",
      "css": ".ds-btn-buy{display:inline-flex;align-items:center;gap:.55rem;border-radius:9999px;background:#ff3d7f;color:#2a1633;font-family:'Bagel Fat One',sans-serif;font-size:1.35rem;padding:16px 32px;text-decoration:none;box-shadow:0 0 0 4px #2a1633,inset 0 -6px 0 #c41f5c,inset 0 4px 0 rgba(255,255,255,.4),0 7px 0 4px #2a1633;transition:transform .08s steps(2),box-shadow .08s steps(2),background-color .12s steps(2)}.ds-btn-buy:hover{background:#ff5c93;transform:translateY(-2px);box-shadow:0 0 0 4px #2a1633,inset 0 -6px 0 #c41f5c,inset 0 4px 0 rgba(255,255,255,.4),0 9px 0 4px #2a1633}.ds-btn-buy:active{transform:translateY(6px);box-shadow:0 0 0 4px #2a1633,inset 0 -3px 0 #c41f5c,inset 0 4px 0 rgba(255,255,255,.4),0 1px 0 4px #2a1633}.ds-btn-buy:focus-visible{outline:3px solid #2a1633;outline-offset:3px;box-shadow:0 0 0 6px #ffd166}"
    },
    {
      "name": "Printed Chip",
      "kind": "button",
      "refersTo": "button-chip",
      "description": "Cream key printed on the card: chart, log, feed it.",
      "html": "<button class=\"ds-btn-chip\">chart</button>",
      "css": ".ds-btn-chip{display:inline-flex;align-items:center;gap:.45rem;border:0;border-radius:9999px;background:#fff3e2;color:#2a1633;font-family:'Gabarito Variable','Gabarito',system-ui,sans-serif;font-weight:700;font-size:.95rem;padding:.6rem 1.05rem;cursor:pointer;box-shadow:0 0 0 3px #2a1633,0 4px 0 3px #2a1633;transition:transform .08s steps(2),box-shadow .08s steps(2),background-color .12s steps(2)}.ds-btn-chip:hover{background:#ffd166}.ds-btn-chip:active{transform:translateY(4px);box-shadow:0 0 0 3px #2a1633}.ds-btn-chip:focus-visible{outline:3px solid #2a1633;outline-offset:3px;box-shadow:0 0 0 6px #ffd166}"
    },
    {
      "name": "Dark Chip",
      "kind": "button",
      "refersTo": "button-chip-dark",
      "description": "Cream-ringed key for actions on the plum ground.",
      "html": "<div style=\"background:#2a1633;padding:24px\"><button class=\"ds-btn-dark\">open the full log</button></div>",
      "css": ".ds-btn-dark{display:inline-flex;align-items:center;gap:.5rem;border:0;border-radius:9999px;background:transparent;padding:1rem 1.6rem;font-family:'Gabarito Variable','Gabarito',system-ui,sans-serif;font-weight:700;font-size:1rem;color:#fff3e2;cursor:pointer;box-shadow:inset 0 0 0 3px #fff3e2;transition:background-color .12s steps(2),color .12s steps(2)}.ds-btn-dark:hover{background:#fff3e2;color:#2a1633}.ds-btn-dark:focus-visible{outline:3px solid #2a1633;outline-offset:3px;box-shadow:0 0 0 6px #ffd166}"
    },
    {
      "name": "LCD Key",
